# Copy this file to .env.local (for local dev) or set these as real
# environment variables in your hosting provider for production.

# Required in production. Any long random string — used to sign login
# session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the site, used to build links in outgoing emails
# (e.g. the account-verification link).
APP_URL=http://localhost:3000

# Payment processor selection. "mock" (default) never moves real money —
# see src/lib/payments/index.ts for how to add a real processor
# (Stripe, PayPal, Authorize.net, etc.) and switch this value to it.
PAYMENT_PROVIDER=mock

# Outbound email selection. "console" (default) logs emails to the server
# console instead of sending them — see src/lib/mailer.ts to wire up a
# real provider (SMTP, SendGrid, SES, etc.).
EMAIL_PROVIDER=console
